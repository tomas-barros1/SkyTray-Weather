<Window
    x:Class="WinuiWheaterForecastTray.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙️ " FontSize="16" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtTitle" Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <!-- Settings Options Card -->
        <Border Grid.Row="1" CornerRadius="10" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="16">
                <!-- Autostart CheckBox -->
                <CheckBox x:Name="ChkAutostart" Click="ChkAutostart_Click" FontSize="14" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                    <TextBlock x:Name="TxtStartWithWindows" Text="Start with Windows" VerticalAlignment="Center" />
                </CheckBox>

                <!-- Refresh Interval Selector -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtRefreshInterval" Text="Refresh interval:" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ComboBox x:Name="CmbRefreshInterval" Grid.Column="1" SelectionChanged="CmbRefreshInterval_SelectionChanged" Width="130" VerticalAlignment="Center">
                        <ComboBoxItem Content="5 min" Tag="5" />
                        <ComboBoxItem Content="10 min" Tag="10" />
                        <ComboBoxItem Content="15 min" Tag="15" IsSelected="True" />
                        <ComboBoxItem Content="30 min" Tag="30" />
                        <ComboBoxItem Content="60 min" Tag="60" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Button x:Name="BtnSave" Click="BtnSave_Click" Grid.Row="2" Content="OK" HorizontalAlignment="Right" Margin="0,16,0,0" Width="80" Style="{StaticResource AccentButtonStyle}" />
    </Grid>
</Window>
