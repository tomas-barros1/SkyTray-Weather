<Window
    x:Class="WinuiWheaterForecastTray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinuiWheaterForecastTray.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="16" Background="Transparent">
        <!-- Progress Ring / Loading Overlay -->
        <StackPanel x:Name="LoadingStack" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
            <ProgressRing IsActive="True" Width="48" Height="48" Margin="0,0,0,12" />
            <TextBlock x:Name="LblLoading" Text="Fetching weather data..." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Main Weather Content -->
        <Grid x:Name="ContentGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Bar with Date & City -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDate" Text="Sexta-feira, 31/07" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="📍 " FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtCity" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6,4" ToolTipService.ToolTip="Refresh Weather">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource SubtleButtonStyle}" Padding="6,4" Margin="4,0,0,0" ToolTipService.ToolTip="Close to Tray">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hero Card (Supports long condition names like "Predominantemente Limpo") -->
            <Border Grid.Row="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtTemperature" FontSize="36" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,-2" />
                        <TextBlock x:Name="TxtCondition" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,1,0,3" />
                        <TextBlock x:Name="TxtFeelsLike" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <TextBlock x:Name="TxtEmoji" Grid.Column="1" FontSize="46" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,0,0" />
                </Grid>
            </Border>

            <!-- 3x3 Weather Metrics Grid -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 1 -->
                <!-- Humidity -->
                <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblHumidity" Text="💧 Humidity" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtHumidity" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Wind Speed -->
                <Border Grid.Row="0" Grid.Column="2" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblWind" Text="🌬️ Wind" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtWind" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Cloud Cover -->
                <Border Grid.Row="0" Grid.Column="4" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblCloudCover" Text="☁️ Clouds" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtCloudCover" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Row 2 -->
                <!-- Rain / Precipitation -->
                <Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblRain" Text="☔ Rain" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtPrecipitation" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Pressure -->
                <Border Grid.Row="2" Grid.Column="2" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblPressure" Text="⏲️ Pressure" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtPressure" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Air Quality -->
                <Border Grid.Row="2" Grid.Column="4" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblAirQuality" Text="🍃 Air Quality" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtAirQuality" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Row 3 -->
                <!-- UV Index -->
                <Border Grid.Row="4" Grid.Column="0" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblUV" Text="☀️ UV Index" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtUV" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Sunrise -->
                <Border Grid.Row="4" Grid.Column="2" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblSunrise" Text="🌅 Sunrise" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtSunrise" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Sunset -->
                <Border Grid.Row="4" Grid.Column="4" CornerRadius="8" Padding="4,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="LblSunset" Text="🌇 Sunset" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtSunset" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 6-Hour Horizontal Forecast Section -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblNext6Hours" Grid.Row="0" Text="Next 6 Hours" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,6" />

                <ItemsControl Grid.Row="1" x:Name="HourlyItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:HourlyForecastItem">
                            <Border CornerRadius="10" Padding="4,6" Width="48" Margin="2,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedTime}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Emoji}" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,2" />
                                    <TextBlock Text="{x:Bind DisplayTemperature}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
