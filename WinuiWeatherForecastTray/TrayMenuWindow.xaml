<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinuiWeatherForecastTray.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!-- Tray context menu (right click). Closes when it loses focus or on Esc. -->
    <Grid x:Name="RootGrid" Padding="4" KeyDown="RootGrid_KeyDown">
        <StackPanel Spacing="2">
            <Button x:Name="BtnSettings" Click="BtnSettings_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="12,9">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16" />
                    <TextBlock x:Name="TxtSettings" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnExit" Click="BtnExit_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="12,9">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="16" />
                    <TextBlock x:Name="TxtExit" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
